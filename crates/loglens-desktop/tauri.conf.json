{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "LogLens",
  "version": "0.1.0",
  "identifier": "dev.loglens.desktop",
  "build": {
    "frontendDist": "../../apps/web/build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --prefix apps/web",
    "beforeBuildCommand": "npm run build --prefix apps/web"
  },
  "app": {
    "windows": [
      {
        "title": "LogLens",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
