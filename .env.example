# LogLens Configuration Example

LOGLENS_HOST=0.0.0.0
LOGLENS_PORT=8080
LOGLENS_BASE_URL=http://localhost:8080
LOGLENS_DATABASE_URL=sqlite:///data/loglens.db
LOGLENS_DATA_DIR=/data
LOGLENS_UPLOAD_DIR=/data/uploads
LOGLENS_EXPORT_DIR=/data/exports
LOGLENS_TEMP_DIR=/data/tmp
LOGLENS_ALLOWED_WATCH_ROOTS=/logs
LOGLENS_MAX_UPLOAD_BYTES=1073741824
LOGLENS_MAX_EXTRACTED_BYTES=4294967296
LOGLENS_MAX_ARCHIVE_ENTRIES=10000
LOGLENS_MAX_LINE_BYTES=1048576
LOGLENS_MAX_EVENT_BYTES=8388608
LOGLENS_MAX_CONCURRENT_IMPORTS=2
LOGLENS_REGISTRATION_ENABLED=false
LOGLENS_BOOTSTRAP_ADMIN_EMAIL=admin@loglens.local
LOGLENS_BOOTSTRAP_ADMIN_PASSWORD=change-me-immediately-in-production!
LOGLENS_SESSION_SECRET=change-this-session-secret-min-32-bytes-long!
LOGLENS_COOKIE_SECURE=false
LOGLENS_TRUST_PROXY=false
LOGLENS_TRUSTED_AUTH_HEADER=
LOGLENS_RETENTION_DAYS=30
LOGLENS_MAX_WORKSPACE_BYTES=10737418240
LOGLENS_LOG_LEVEL=info
LOGLENS_TELEMETRY_ENABLED=false
